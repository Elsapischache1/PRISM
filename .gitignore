# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Model & feature files (large binaries — use Git LFS or exclude entirely) ──
audio_deepfake/model/*.joblib
audio_deepfake/features/*.npy
video_deepfake/model/*.pt
video_deepfake/model/*.pth
video_deepfake/model/*.h5
video_deepfake/features/

# ── Dataset (never commit raw data) ───────────────────────────────────────────
dataset/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.mp4
*.mov
*.avi
*.mkv

# ── Plots & outputs ────────────────────────────────────────────────────────────
audio_deepfake/plots/
video_deepfake/plots/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
*.key
secrets.py

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.user

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
tmp/
temp/
uploads/